class_name Maps
extends RefCounted
## Level layouts as ASCII grids (16px tiles), Prince of Persia style: edit the strings.
##   #  rock          .  air            P  hero start      E  exit
##   o  whip anchor   T  wall torch     C  crate           D  straw dummy
##   ^  spikes        c  crumbling floor | gate (column)   _  pressure plate
##   K  checkpoint    L  lantern        ?  sign (texts from "signs", in reading order)
##   s  scorpion      r  rattlesnake    B  bandit          J  jaguar        G  Guardian
##   b  brute         m  machete bandit d  attack dog      l  attack llama
##   /  \  slopes: a run of N on one row rises (/) or falls (\) one tile over N tiles
##   Y  dead tree / pillar to kick over (stack for height)   %  cracked rock (kick / grenade)
##   N  NPC ("npcs" list)   !  story trigger ("triggers")   *  relic fragment   g  grenade crate
## Outside the grid, left/right/bottom count as solid rock and the top is open sky.
## The campaign levels are generated by tools/build_maps.py into CampaignMaps; these are
## the test rooms (reachable with `-- --map <id>`).
## "dark" rects (tile coords x, y, w, h) get a back wall and dim the ambient light.

static func get_map(id: String) -> Dictionary:
	return CampaignMaps.ALL[id] if CampaignMaps.ALL.has(id) else ALL[id]


