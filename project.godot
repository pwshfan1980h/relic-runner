; Engine configuration file.
config_version=5

[application]

config/name="Relic Runner"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Controls="*res://scripts/autoload/controls.gd"
Fx="*res://scripts/autoload/fx.gd"
Audio="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="fractional"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="hero"
2d_physics/layer_3="actors"
2d_physics/layer_4="anchors"

[physics]

common/physics_ticks_per_second=120
2d/default_gravity=900.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.11, 0.07, 0.05, 1)
